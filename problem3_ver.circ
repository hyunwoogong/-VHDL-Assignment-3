    </comp>
    <comp loc="(600,290)" name="problem3"/>
    <wire from="(360,290)" to="(380,290)"/>
    <wire from="(360,310)" to="(380,310)"/>
    <wire from="(380,310)" to="(390,310)"/>
    <wire from="(600,290)" to="(630,290)"/>
    <wire from="(600,310)" to="(630,310)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="problem3">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity problem3 is
    Port (
        D     : in  STD_LOGIC;
        clk   : in  STD_LOGIC;
        Q     : out STD_LOGIC;
        Q_bar : out STD_LOGIC
    );
end problem3;

architecture Behavioral of problem3 is
    signal q_reg : STD_LOGIC := '0';
begin

    process(clk)
    begin
        if rising_edge(clk) then
            q_reg &lt;= D;
        end if;
    end process;

    Q     &lt;= q_reg;
    Q_bar &lt;= not q_reg;

end Behavioral;
</vhdl>
