    </comp>
    <comp lib="0" loc="(570,330)" name="Pin">
      <a name="appearance" val="classic"/>
      <a name="facing" val="west"/>
      <a name="type" val="output"/>
    </comp>
    <comp loc="(530,310)" name="problem5"/>
    <wire from="(290,310)" to="(310,310)"/>
    <wire from="(290,330)" to="(310,330)"/>
    <wire from="(290,350)" to="(310,350)"/>
    <wire from="(290,370)" to="(310,370)"/>
    <wire from="(530,310)" to="(570,310)"/>
    <wire from="(530,330)" to="(570,330)"/>
  </circuit>
  <vhdl appearance="logisim_evolution" name="problem5">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity problem5 is
    Port (
        clk  : in  STD_LOGIC;
        set  : in  STD_LOGIC;
        clr  : in  STD_LOGIC;
        D    : in  STD_LOGIC;
        Q    : out STD_LOGIC;
        Qbar : out STD_LOGIC
    );
end problem5;

architecture Behavioral of problem5 is
    signal q_internal : STD_LOGIC;
begin

    process(clk, set, clr)
    begin
        if clr = '1' then
            q_internal &lt;= '0';

        elsif set = '1' then
            q_internal &lt;= '1';

        elsif rising_edge(clk) then
            q_internal &lt;= D;

        end if;
    end process;

    Q    &lt;= q_internal;
    Qbar &lt;= not q_internal;

end Behavioral;
</vhdl>
